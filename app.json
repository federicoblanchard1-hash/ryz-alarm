{
  "expo": {
    "name": "Ryz",
    "slug": "ryz-alarm",
    "version": "1.0.0",
    "scheme": "ryz",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ryzalarm.app",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.ryzalarm.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_SLEEP"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/deep_520hz.wav",
            "./assets/sounds/science_deep_400.wav",
            "./assets/sounds/gentle_melody.wav",
            "./assets/sounds/science_rising.wav",
            "./assets/sounds/science_rhythmic.wav",
            "./assets/sounds/loud_air_raid.wav",
            "./assets/sounds/loud_wail.wav",
            "./assets/sounds/loud_yelp.wav",
            "./assets/sounds/loud_two_tone.wav",
            "./assets/sounds/loud_hi_lo.wav",
            "./assets/sounds/loud_red_alert.wav",
            "./assets/sounds/loud_klaxon.wav",
            "./assets/sounds/loud_foghorn.wav",
            "./assets/sounds/loud_car.wav",
            "./assets/sounds/loud_continuous.wav",
            "./assets/sounds/loud_pulse.wav",
            "./assets/sounds/loud_buzzer.wav",
            "./assets/sounds/loud_escalating.wav",
            "./assets/sounds/loud_smoke.wav",
            "./assets/sounds/loud_bell.wav",
            "./assets/sounds/loud_fire_bell.wav",
            "./assets/sounds/loud_phone.wav",
            "./assets/sounds/loud_reveille.wav",
            "./assets/sounds/calm_birds.wav",
            "./assets/sounds/calm_forest.wav",
            "./assets/sounds/calm_rain.wav",
            "./assets/sounds/calm_stream.wav",
            "./assets/sounds/calm_ocean.wav",
            "./assets/sounds/calm_wind_chimes.wav",
            "./assets/sounds/calm_sunrise.wav",
            "./assets/sounds/calm_piano.wav",
            "./assets/sounds/calm_harp.wav",
            "./assets/sounds/calm_guitar.wav",
            "./assets/sounds/calm_kalimba.wav",
            "./assets/sounds/calm_music_box.wav",
            "./assets/sounds/calm_lofi.wav",
            "./assets/sounds/calm_singing_bowl.wav",
            "./assets/sounds/calm_pink_noise.wav",
            "./assets/sounds/calm_brown_noise.wav",
            "./assets/sounds/chime.wav"
          ]
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ryz uses your location to show the weather where you wake up."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Ryz counts your shakes, squats and steps for wake-up missions."
        }
      ],
      "expo-web-browser",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Ryz uses the camera to scan the QR code or barcode you chose for a wake-up mission, so you have to get out of bed to stop the alarm.",
          "recordAudioAndroid": false
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Ryz reads the sleep your watch records, so your nights appear in the sleep tracker without pressing a button.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ]
  }
}
