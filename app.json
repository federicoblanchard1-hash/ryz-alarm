{
  "expo": {
    "name": "Ryz",
    "slug": "ryz-alarm",
    "version": "1.0.0",
    "scheme": "ryz",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ryzalarm.app",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.ryzalarm.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_SLEEP"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/deep_520hz.wav",
            "./assets/sounds/science_deep_400.wav",
            "./assets/sounds/gentle_melody.wav",
            "./assets/sounds/science_rising.wav",
            "./assets/sounds/science_rhythmic.wav",
            "./assets/sounds/loud_air_raid.wav",
            "./assets/sounds/loud_wail.wav",
            "./assets/sounds/loud_yelp.wav",
            "./assets/sounds/loud_two_tone.wav",
            "./assets/sounds/loud_hi_lo.wav",
            "./assets/sounds/loud_red_alert.wav",
            "./assets/sounds/loud_klaxon.wav",
            "./assets/sounds/loud_foghorn.wav",
            "./assets/sounds/loud_car.wav",
            "./assets/sounds/loud_continuous.wav",
            "./assets/sounds/loud_pulse.wav",
            "./assets/sounds/loud_buzzer.wav",
            "./assets/sounds/loud_escalating.wav",
            "./assets/sounds/loud_smoke.wav",
            "./assets/sounds/loud_bell.wav",
            "./assets/sounds/loud_fire_bell.wav",
            "./assets/sounds/loud_phone.wav",
            "./assets/sounds/loud_reveille.wav",
            "./assets/sounds/calm_birds.wav",
            "./assets/sounds/calm_forest.wav",
            "./assets/sounds/calm_rain.wav",
            "./assets/sounds/calm_stream.wav",
            "./assets/sounds/calm_ocean.wav",
            "./assets/sounds/calm_wind_chimes.wav",
            "./assets/sounds/calm_sunrise.wav",
            "./assets/sounds/calm_piano.wav",
            "./assets/sounds/calm_harp.wav",
            "./assets/sounds/calm_guitar.wav",
            "./assets/sounds/calm_kalimba.wav",
            "./assets/sounds/calm_music_box.wav",
            "./assets/sounds/calm_lofi.wav",
            "./assets/sounds/calm_singing_bowl.wav",
            "./assets/sounds/calm_pink_noise.wav",
            "./assets/sounds/calm_brown_noise.wav",
            "./assets/sounds/chime.wav"
          ]
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ryz uses your location to show the weather where you wake up."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Ryz counts your shakes, squats and steps for wake-up missions."
        }
      ],
      "expo-web-browser",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Ryz uses the camera to scan the QR code or barcode you chose for a wake-up mission, so you have to get out of bed to stop the alarm.",
          "recordAudioAndroid": false
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Ryz reads the sleep your watch records, so your nights appear in the sleep tracker without pressing a button.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Halloween",
            "ios": "./assets/icons/halloween.png",
            "android": {
              "foregroundImage": "./assets/icons/halloween-android.png",
              "backgroundColor": "#FF7A00"
            }
          },
          {
            "name": "Christmas",
            "ios": "./assets/icons/christmas.png",
            "android": {
              "foregroundImage": "./assets/icons/christmas-android.png",
              "backgroundColor": "#14532D"
            }
          },
          {
            "name": "NewYear",
            "ios": "./assets/icons/new-year.png",
            "android": {
              "foregroundImage": "./assets/icons/new-year-android.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Valentines",
            "ios": "./assets/icons/valentines.png",
            "android": {
              "foregroundImage": "./assets/icons/valentines-android.png",
              "backgroundColor": "#E63950"
            }
          },
          {
            "name": "Spring",
            "ios": "./assets/icons/spring.png",
            "android": {
              "foregroundImage": "./assets/icons/spring-android.png",
              "backgroundColor": "#F3EFE4"
            }
          },
          {
            "name": "Summer",
            "ios": "./assets/icons/summer.png",
            "android": {
              "foregroundImage": "./assets/icons/summer-android.png",
              "backgroundColor": "#FFC23C"
            }
          },
          {
            "name": "Winter",
            "ios": "./assets/icons/winter.png",
            "android": {
              "foregroundImage": "./assets/icons/winter-android.png",
              "backgroundColor": "#0E1F3B"
            }
          },
          {
            "name": "Autumn",
            "ios": "./assets/icons/autumn.png",
            "android": {
              "foregroundImage": "./assets/icons/autumn-android.png",
              "backgroundColor": "#9A3412"
            }
          },
          {
            "name": "LunarNewYear",
            "ios": "./assets/icons/lunar-new-year.png",
            "android": {
              "foregroundImage": "./assets/icons/lunar-new-year-android.png",
              "backgroundColor": "#B91C1C"
            }
          },
          {
            "name": "StPatricks",
            "ios": "./assets/icons/st-patricks.png",
            "android": {
              "foregroundImage": "./assets/icons/st-patricks-android.png",
              "backgroundColor": "#15803D"
            }
          },
          {
            "name": "Easter",
            "ios": "./assets/icons/easter.png",
            "android": {
              "foregroundImage": "./assets/icons/easter-android.png",
              "backgroundColor": "#CFE8F3"
            }
          },
          {
            "name": "Pride",
            "ios": "./assets/icons/pride.png",
            "android": {
              "foregroundImage": "./assets/icons/pride-android.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Light",
            "ios": "./assets/icons/light.png",
            "android": {
              "foregroundImage": "./assets/icons/light-android.png",
              "backgroundColor": "#F4F3EF"
            }
          },
          {
            "name": "Gold",
            "ios": "./assets/icons/gold.png",
            "android": {
              "foregroundImage": "./assets/icons/gold-android.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Sunrise",
            "ios": "./assets/icons/sunrise.png",
            "android": {
              "foregroundImage": "./assets/icons/sunrise-android.png",
              "backgroundColor": "#D9507A"
            }
          }
        ]
      ]
    ]
  }
}
